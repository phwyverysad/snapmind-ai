{
  "name": "snapmind-ai",
  "productName": "SnapMind AI",
  "version": "1.0.10",
  "description": "SnapMind AI - Electron AI Screen Scanner powered by Google AI Studio Gemini API",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 -c.win.target=nsis-web",
    "dist:offline": "electron-builder --win --x64 -c.win.target=nsis",
    "dist:portable": "electron-builder --win --x64 -c.win.target=portable"
  },
  "build": {
    "appId": "com.snapmind.ai",
    "productName": "SnapMind AI",
    "compression": "maximum",
    "afterPack": "./build/clean-unpacked.js",
    "electronLanguages": [
      "th",
      "en",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "main.js",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/*.d.ts",
      "!**/*.ts",
      "!**/LICENSE*",
      "!**/README*",
      "!**/CHANGELOG*",
      "!**/doc/**",
      "!**/docs/**",
      "!**/examples/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/test*/**",
      "!tests/**/*",
      "!**/.agents/**",
      "!**/.skills/**",
      "!**/.gemini/**",
      "!**/*.txt",
      "!*.cpp",
      "!*.obj",
      "!*.exp",
      "!*.lib",
      "!*.cs"
    ],
    "publish": {
      "provider": "github",
      "owner": "phwyverysad",
      "repo": "snapmind-ai"
    },
    "extraResources": [
      {
        "from": "native",
        "to": ".",
        "filter": [
          "GeminiTextCopy.dll",
          "hotkey_hook.dll",
          "hotkey_hook.exe",
          "NativeScreenCapture.dll"
        ]
      },
      {
        "from": "assets",
        "to": ".",
        "filter": [
          "SnapMind.ico"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/SnapMind.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "SnapMind-AI-Portable.exe",
      "requestExecutionLevel": "user"
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SnapMind AI",
      "installerIcon": "assets/SnapMind.ico",
      "uninstallerIcon": "assets/SnapMind.ico",
      "uninstallDisplayName": "SnapMind AI",
      "artifactName": "SnapMind_AI_WebSetup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SnapMind AI",
      "installerIcon": "assets/SnapMind.ico",
      "uninstallerIcon": "assets/SnapMind.ico",
      "uninstallDisplayName": "SnapMind AI",
      "artifactName": "SnapMind_AI_Setup_Full.exe",
      "differentialPackage": false
    }
  },
  "keywords": [
    "electron",
    "gemini",
    "ai",
    "ocr",
    "screen-scanner"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "koffi": "^3.3.1"
  }
}
